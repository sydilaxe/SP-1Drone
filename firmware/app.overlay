/* SP-1Drone (as SP-1FX): the faders and the battery on the SAADC (channels 0 and 1, the button ladders, are in
 * the board file). Same settings as the button ladders: gain 1/6, internal reference, 12-bit, so a
 * fader reads about 0 (down) to 3700 (up). From chattock/sp1-tape-looper (MIT). */
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

&adc {
	channel@2 { reg = <2>; zephyr,gain = "ADC_GAIN_1_6"; zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 20)>;
		zephyr,input-positive = <NRF_SAADC_AIN3>; zephyr,resolution = <12>; };   /* Fader 1 P0.05 */
	channel@3 { reg = <3>; zephyr,gain = "ADC_GAIN_1_6"; zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 20)>;
		zephyr,input-positive = <NRF_SAADC_AIN6>; zephyr,resolution = <12>; };   /* Fader 2 P0.30 */
	channel@4 { reg = <4>; zephyr,gain = "ADC_GAIN_1_6"; zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 20)>;
		zephyr,input-positive = <NRF_SAADC_AIN2>; zephyr,resolution = <12>; };   /* Fader 3 P0.04 */
	channel@5 { reg = <5>; zephyr,gain = "ADC_GAIN_1_6"; zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 20)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>; zephyr,resolution = <12>; };   /* Fader 4 P0.31 */
	channel@6 { reg = <6>; zephyr,gain = "ADC_GAIN_1_6"; zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 20)>;
		zephyr,input-positive = <NRF_SAADC_AIN4>; zephyr,resolution = <12>; };   /* Battery P0.28 */
};
&zephyr_user {
	io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>, <&adc 4>, <&adc 5>, <&adc 6>;
};

/* USB audio, the other way from SP-1FX's: the SP-1 is a USB sound source (a synthesizer) and the host records it.
 * The board's host-to-SP-1 "speaker" goes; in its place one stream to the host, 48 kHz stereo, 16-bit here
 * (alternate setting 1: what every host opens, computers, phones, Linux handhelds) and 24-bit (alternate setting 2,
 * added by the UAC2 class, CONFIG_USBD_UAC2_SP1_ALT24); the host picks. Asynchronous: the SP-1's own clock sets
 * the rate, a packet of 47, 48 or 49 frames each millisecond (no implicit-feedback: the host follows the packets). */
#include <zephyr/dt-bindings/usb/audio.h>
/delete-node/ &uac2_speaker;
/ {
	uac2_drone: usb_audio2 {
		compatible = "zephyr,uac2";
		status = "okay";
		full-speed;
		audio-function = <AUDIO_FUNCTION_MUSICAL_INSTRUMENT>;

		uac_aclk: aclk {
			compatible = "zephyr,uac2-clock-source";
			clock-type = "internal-fixed";
			frequency-control = "read-only";
			sampling-frequencies = <48000>;
		};

		synth_in: synth {
			compatible = "zephyr,uac2-input-terminal";
			clock-source = <&uac_aclk>;
			terminal-type = <EMBEDDED_TERMINAL_SYNTHESIZER>;
			front-left;
			front-right;
		};

		usb_out: usb_out {
			compatible = "zephyr,uac2-output-terminal";
			data-source = <&synth_in>;
			clock-source = <&uac_aclk>;
			terminal-type = <USB_TERMINAL_STREAMING>;
		};

		as_iso_in: in_interface {
			compatible = "zephyr,uac2-audio-streaming";
			linked-terminal = <&usb_out>;
			subslot-size = <2>;
			bit-resolution = <16>;
		};
	};
};
